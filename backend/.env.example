# Copy to .env (never commit it). Every value has a development default.
# Restart the backend after editing.

# ---------------------------------------------------------------- Voices
# elevenlabs | system (macOS voices; default on a Mac) | chatterbox | none
# LANGUAGE_APP_TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Fallback voice for any speaker not listed below (Sophie's voice in the Ren'Py version).
# ELEVENLABS_VOICE_ID=
# A voice per character, by the game's speaker IDs.
# ELEVENLABS_VOICES={"sophie":"","barista":"","baker":"","neighbor":""}
# Speaking speed (0.7 to 1.2). A little slower than natural suits learners.
# ELEVENLABS_SPEED=0.9
# ELEVENLABS_SLOW_SPEED=0.75

# macOS voices per language and speaker; a list is in order of preference.
# SYSTEM_VOICES={"fr":{"default":["Audrey (Premium)","Amélie"],"baker":"Thomas"}}

# Chatterbox (backend/tts_service), only with LANGUAGE_APP_TTS_PROVIDER=chatterbox.
# CHATTERBOX_URL=http://127.0.0.1:8001
# CHATTERBOX_TIMEOUT=60

# Where generated speech is cached. "off" disables caching.
# LANGUAGE_APP_TTS_CACHE_DIR=.tts_cache

# ---------------------------------------------------------------- Recognition
# elevenlabs (Scribe; the default when ELEVENLABS_API_KEY is set) | faster-whisper (local) | none
# LANGUAGE_APP_STT_PROVIDER=elevenlabs
# FASTER_WHISPER_MODEL=large-v3-turbo
# FASTER_WHISPER_DEVICE=auto
# FASTER_WHISPER_COMPUTE_TYPE=auto
# FASTER_WHISPER_BEAM_SIZE=1

# ---------------------------------------------------------------- AI second opinion
# Without a key the layer is off and the game relies on its own rules.
# OPENROUTER_API_KEY=
# AI_PROVIDER=openrouter
# AI_MODEL=google/gemini-3.1-flash-lite
# AI_TIMEOUT_MS=8000
# AI_REQUESTS_PER_MINUTE=60

# ---------------------------------------------------------------- Pronunciation
# Load the phoneme model at startup instead of on the first request.
# PRONUNCIATION_PRELOAD=true

# Extra languages characters may be voiced in (Sophie's English welcome).
# VOICE_LANGUAGES=en

# ---------------------------------------------------------------- Access
# Web pages allowed to call the API. The default covers the dev page and the iOS/Android apps.
# CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost,http://localhost
# Languages characters speak and learners may answer in.
# SPEECH_LANGUAGES=fr
