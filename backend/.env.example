# Copy to .env (never commit it). Every value has a development default.

# Port the API listens on.
PORT=3000

# Origins allowed to call the API from a web view, comma-separated. The default
# covers the development page and the installed iOS and Android apps.
# CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost,http://localhost

# Languages learners may speak, comma-separated.
SPEECH_LANGUAGES=fr

# The speech/ML service (FastAPI, local Whisper). Only the backend talks to it.
SPEECH_SERVICE_URL=http://127.0.0.1:8000

# Text-to-speech provider. "system" uses the voices built into macOS and needs no key.
# Hosted providers are added as adapters under src/speech/providers and take their
# credentials from this file; keys never reach the client.
TTS_PROVIDER=system

# Where generated speech is cached. "off" disables caching.
TTS_CACHE_DIR=.tts-cache

# Voice per speaker and language, as JSON: { "<language>": { "<speakerId>": "<voice>", "default": "<voice>" } }.
# A value may be a list in order of preference; the first voice the provider has is used.
# Voice names belong to the chosen provider and stay on the server.
# TTS_VOICES={"fr":{"default":["Audrey (Premium)","Amélie"],"baker":"Thomas"}}

# AI conversation layer: a second opinion on what the learner meant, and an
# in-character reply when it did not come across. "none" turns it off; the game
# then relies on its own rules. Defaults to "openrouter" when a key is present.
# AI_PROVIDER=openrouter
# The key stays in this file on the server. Never put it in the frontend.
# OPENROUTER_API_KEY=
# Any model on the provider that supports structured output.
# AI_MODEL=google/gemini-3.1-flash-lite
# AI_TIMEOUT_MS=8000
# Model calls allowed per minute across all players; a cost and abuse guard.
# AI_REQUESTS_PER_MINUTE=60
