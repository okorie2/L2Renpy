# Characters used by the opening scene.

# advance=False: tapping the screen (or Enter/Space) doesn't skip a line.
# Lines move on by themselves (dialogue auto-advance, see mobile_theme.rpy).
# A line with (show_auto_advance=False) shows the card's next arrow instead,
# which is then the only way to continue. To make a single line
# tap-to-advance again, add (advance=True) after it.
define Sophie = Character("Sophie", advance=False)
define me = Character("Me", advance=False)
