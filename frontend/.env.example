# Copy to .env.local to change. Without a backend the game runs silently.

# Base URL of the application backend (voiced lines).
# In development it defaults to http://localhost:3000.
# VITE_API_URL=http://localhost:3000

# The opening and walk to the café use a 3D stage by default.
# Set false to use the illustrated version on all devices.
# VITE_STORY_3D=false

# Set false to compare the 3D proxy with its original smooth lighting.
# VITE_STORY_TOON=false

# Set true to compare Sophie with the original CC0 proxy model.
# VITE_SOPHIE_PROXY=true

# Set study to compare the previous Blender face study with the Meshy character.
# VITE_SOPHIE_MODEL=study
