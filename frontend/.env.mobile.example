# Settings for the iOS and Android builds (`npm run cap:sync`).
# Copy to .env.mobile.local, which stays on this machine.

# The backend the app talks to. A phone cannot reach "localhost" on your computer:
# use the computer's address on the Wi-Fi both are on (System Settings > Wi-Fi >
# Details), or the address of a hosted backend. Without it the app is silent and
# typed-only, and otherwise the same.
VITE_API_URL=http://192.168.0.10:3000
